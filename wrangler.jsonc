{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karu-ai",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karu-backend-db",
      "database_id": "76ad95bf-3097-4caf-a4f7-9d3c1568dd39"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KARU_MEDIA",
      "id": "c84d273cae1544b798f9bc607d8150e9"
    }
  ],
  "vars": {
    "JWT_SECRET": "karu_ai_secure_jwt_secret_2026_key",
    "FB_APP_ID": "2130186284573679",
    "INSTAGRAM_ACCOUNT_ID": "17841475705860104",
    "FACEBOOK_PAGE_ID": "1325245597340956",
    "POLAR_ENVIRONMENT": "sandbox",
    "POLAR_PRODUCT_BASIC_ID": "bc5db1a0-ab63-462b-9db9-69aa3234147a",
    "POLAR_PRODUCT_PRO_ID": "9e597298-d8ce-4b7b-a5d6-e9f3329b8fa5",
    "POLAR_PRODUCT_AGENCY_ID": "6aef381c-54a0-4475-afe3-fa63ed768152"
  }
}
